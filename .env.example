# Copie para .env e ajuste se necessário. Tudo tem default sensato —
# o container sobe sem .env nenhum.

# UID/GID do dono dos arquivos em /config e /games
#PUID=1000
#PGID=1000

# Timezone (formato IANA)
#TZ=UTC

# GID do grupo com acesso a /dev/dri/renderD128 no host.
# Auto-detectado dentro do container; só defina se a detecção falhar.
#RENDER_GID=

# Caminhos no host para os dois volumes de dados
#CONFIG_DIR=./dockerdata/dosbox-tv
#GAMES_DIR=./games
